# Mobile Dinners — configuration
#
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; never commit a secret key, and never paste one into a chat.
#
#   cp .env.example .env.local
#
# The app runs without any of these: payments fall back to a local sandbox
# processor and one-time codes print on screen. Both are refused in production.

# ---------------------------------------------------------------- payments
# Stripe Connect (Express). From https://dashboard.stripe.com/apikeys
# Use the TEST keys (sk_test_… / pk_test_…) until you are ready to take money.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From https://dashboard.stripe.com/webhooks after adding an endpoint at
#   https://<your-domain>/api/payments/webhook
# Subscribe to: payment_intent.succeeded, payment_intent.payment_failed,
#               charge.refunded, account.updated
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------- secrets
# 32-byte hex key used to seal POS access tokens at rest. Required in
# production — the app refuses to start without it rather than encrypt with a
# key that is published in the source. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MD_TOKEN_KEY=

# -------------------------------------------------------------- deployment
# Public origin, used to build Stripe onboarding return links.
MD_PUBLIC_URL=http://localhost:3100

# Where the SQLite database lives. Point this at a mounted volume in production.
MD_DATA_DIR=

# Set to true to allow the demo restaurants and their shared password to be
# seeded in production. Leave unset for a real deployment.
MD_ALLOW_DEMO_SEED=

# ---------------------------------------------------- not yet implemented
# Listed so the shape is known; nothing reads these today.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# RESEND_API_KEY=
# MAPS_API_KEY=

# ---------------------------------------------------------------- delivery
# DoorDash Drive — white-label courier network. Not the DoorDash marketplace:
# no listing, no commission, and the diner never leaves our app.
# From https://developer.doordash.com/portal — create a Drive credential set.
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=

# Signs inbound status updates. Add a webhook in the portal pointing at
#   https://<your-domain>/api/delivery/webhook
DOORDASH_WEBHOOK_SECRET=

# Set to "sandbox" while testing so the ops dashboard says so out loud.
DOORDASH_ENV=sandbox
